# Replace this placeholder before starting the gateway. Do not commit a real token.
POCKET_AGENT_TOKEN=<generate-a-long-random-token>

# Safe default: only this machine can reach the gateway.
POCKET_AGENT_BIND_ADDR=127.0.0.1:8787
POCKET_AGENT_ALLOW_REMOTE=false

# The upstream is intentionally restricted to a loopback ws:// IP address.
POCKET_AGENT_CODEX_URL=ws://127.0.0.1:8765
POCKET_AGENT_AUTO_START_CODEX=true
POCKET_AGENT_CODEX_BIN=codex
POCKET_AGENT_CODEX_START_TIMEOUT_MS=10000

# SSH control uses the gateway machine's existing key, agent, and ~/.ssh/config.
POCKET_AGENT_SSH_BIN=ssh
POCKET_AGENT_SSH_START_TIMEOUT_MS=20000
POCKET_AGENT_SSH_REMOTE_PORT=4500

POCKET_AGENT_FRONTEND_DIR=frontend/dist
